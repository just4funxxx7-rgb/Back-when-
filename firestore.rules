rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Bootstrapped Admin & Trusted Admin Collection Lookup
    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'new.dawn.industries2026@gmail.com' ||
        request.auth.token.email == 'just4funxxx7@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Blueprint Validation Helpers
    function isValidAdminRegistry(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'unifiedProjectName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'grantedBy', 'unifiedProjectName', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.grantedBy == request.auth.uid &&
        data.unifiedProjectName is string && data.unifiedProjectName.size() >= 1 && data.unifiedProjectName.size() <= 80 &&
        data.createdAt is timestamp;
    }

    function isValidSurvivorProfile(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'level', 'moralKarma', 'dayCount', 'unifiedProjectName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'displayName', 'level', 'moralKarma', 'dayCount', 'unifiedProjectName', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        data.level is int && data.level >= 1 && data.level <= 999 &&
        data.moralKarma is int && data.moralKarma >= -1000 && data.moralKarma <= 1000 &&
        data.dayCount is int && data.dayCount >= 1 && data.dayCount <= 100000 &&
        data.unifiedProjectName is string && data.unifiedProjectName.size() >= 1 && data.unifiedProjectName.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSurvivorPrivateInfo(data) {
      return data.keys().hasAll(['ownerId', 'email', 'lastDocId', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'lastDocId', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.email == request.auth.token.email &&
        data.lastDocId is string && data.lastDocId.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidExpeditionReport(data) {
      return data.keys().hasAll(['ownerId', 'title', 'summary', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'title', 'summary', 'status', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1500 &&
        data.status is string && (data.status == 'draft' || data.status == 'published' || data.status == 'archived') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 1. Admin Registry (/admins/{adminUid})
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminUid) && isValidAdminRegistry(incoming()) && incoming().uid == adminUid && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(adminUid) && isValidAdminRegistry(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['unifiedProjectName']);
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    // 2. Public Survivor Profiles (/survivors/{userId})
    match /survivors/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isOwner(userId) && isValidId(userId) && isValidSurvivorProfile(incoming()) && incoming().ownerId == userId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(userId) && isValidSurvivorProfile(incoming()) && incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'level', 'moralKarma', 'dayCount', 'unifiedProjectName', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && isAdmin();

      // 3. PII-Isolated Private Info Subcollection (/survivors/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin()) && exists(/databases/$(database)/documents/survivors/$(userId));
        allow list: if false;
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidSurvivorPrivateInfo(incoming()) && incoming().ownerId == userId && incoming().updatedAt == request.time && exists(/databases/$(database)/documents/survivors/$(userId));
        allow update: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && isValidSurvivorPrivateInfo(incoming()) && incoming().ownerId == existing().ownerId && incoming().email == existing().email && incoming().updatedAt == request.time && exists(/databases/$(database)/documents/survivors/$(userId)) && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['lastDocId', 'updatedAt']))
        );
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // 4. Field Expedition Reports (/expeditionReports/{reportId})
    match /expeditionReports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(reportId) && isValidExpeditionReport(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time && exists(/databases/$(database)/documents/survivors/$(request.auth.uid));
      allow update: if isVerifiedUser() && isValidId(reportId) && isValidExpeditionReport(incoming()) && incoming().ownerId == existing().ownerId && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
        isAdmin() ||
        (existing().ownerId == request.auth.uid && existing().status != 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'status', 'updatedAt']))
      );
      allow delete: if isValidId(reportId) && isAdmin();
    }
  }
}
